#!/bin/sh
# Xenia Nexus — AppRun routing script.
#   No argument  → launch the Nexus dashboard UI (game library).
#   File argument → pass straight to xenia_edge (emulator-only mode).
set -e
SELF_DIR="$(dirname "$(readlink -f "$0")")"
export APPDIR="${APPDIR:-$SELF_DIR}"
XENIA_EDGE="$APPDIR/usr/bin/xenia_edge"
XENIA_NEXUS="$APPDIR/usr/bin/xenia-nexus"
if [ -n "$1" ] && [ -e "$1" ]; then
    exec "$XENIA_EDGE" "$@"
else
    exec "$XENIA_NEXUS" "$@"
fi
